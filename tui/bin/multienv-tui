#!/usr/bin/env bash

ensure_bash() {
    ((BASH_VERSINFO[0] >= 4)) && return
    local candidate
    for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        [[ -x "$candidate" ]] && exec "$candidate" "$0" "$@"
    done
    printf 'multienv-tui requires Bash 4 or newer\n' >&2
    exit 1
}

ensure_bash "$@"
set -o pipefail

script_dir="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${script_dir}/../lib/prelude.sh"
source "${script_dir}/../lib/select.sh"

printf -v self_command '%q %q' "$BASH" "${script_dir}/multienv-tui"
printf -v child_shell '%q -c' "$BASH"
log_file=/tmp/multienv-tui-last-run.log
sync_pid=''
export MULTIENV_TUI_POPUP="${MULTIENV_TUI_POPUP:-1}"

popup_enabled() {
    [[ "$MULTIENV_TUI_POPUP" == 1 ]]
}

ui_fzf() {
    local display_args=(--no-popup --no-height)
    popup_enabled && display_args=(--tmux)
    fzf "${display_args[@]}" "$@"
}

ui_host_alias() {
    local host="${1:?need hostname}"
    local colors=(36 33 35 32 34 31)
    local i checksum
    for i in "${!c_hostnames[@]}"; do
        [[ "${c_hostnames[$i]}" == "$host" ]] || continue
        printf '\033[%sm%s\033[0m' "${colors[i % ${#colors[@]}]}" \
            "${c_hostname_to_host_alias[$host]:-$host}"
        return
    done
    read -r checksum _ < <(printf '%s' "$host" | cksum)
    printf '\033[%sm%s\033[0m' "${colors[checksum % ${#colors[@]}]}" "$host"
}

host_aliases() {
    local host
    while IFS= read -r host; do
        jq -cn --arg host "$host" --arg alias "$(ui_host_alias "$host")" \
            '{key: $host, value: $alias}'
    done | jq -s 'from_entries'
}

show_error() {
    local message="${1:?need message}"
    printf '%s (see %s)\n' "$message" "$log_file" >&2
    tmux display-message -d 5000 "$message (see $log_file)" 2>>"$log_file" || true
}

archived_visible() {
    [[ -n "${MULTIENV_TUI_STATE_DIR:-}" ]] &&
        [[ -f "${MULTIENV_TUI_STATE_DIR}/archived" ]]
}

toggle_archived() {
    if archived_visible; then
        rm -f "${MULTIENV_TUI_STATE_DIR}/archived"
    else
        touch "${MULTIENV_TUI_STATE_DIR:?need UI state}/archived"
    fi
}

ignored_visible() {
    [[ -n "${MULTIENV_TUI_STATE_DIR:-}" ]] &&
        [[ -f "${MULTIENV_TUI_STATE_DIR}/ignored" ]]
}

toggle_ignored() {
    if ignored_visible; then
        rm -f "${MULTIENV_TUI_STATE_DIR}/ignored"
    else
        touch "${MULTIENV_TUI_STATE_DIR:?need UI state}/ignored"
    fi
}

ui_jq_helpers() {
    cat <<'JQ'
        def text: tostring | gsub("[\u0000-\u001f\u007f-\u009f]"; " ");
        def styled($code): "\u001b[\($code)m\(.)\u001b[0m";
        def field($label):
            (. // "" | text) as $value |
            "\($label): \(if $value == "" then "—" else $value end)" | styled("90");
        def sync_epoch:
            capture("^(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<fraction>\\.[0-9]+)?(?<zone>Z|[+-][0-9]{2}:[0-9]{2})$") |
            (.date + "Z" | fromdateiso8601) +
            ("0" + (.fraction // "") | tonumber) -
            (if .zone == "Z" then 0 else
                ((.zone[1:3] | tonumber) * 3600 + (.zone[4:6] | tonumber) * 60) *
                (if .zone[0:1] == "+" then 1 else -1 end)
             end);
        def ago($unit):
            "\(.) \($unit)\(if . == 1 then "" else "s" end) ago";
        def elapsed:
            if . < 1 then "just now"
            elif . < 60 then floor | ago("second")
            elif . < 3600 then . / 60 | floor | ago("minute")
            elif . < 86400 then . / 3600 | floor | ago("hour")
            else . / 86400 | floor | ago("day") end;
        def synced_field($now):
            ((try (. // "" | sync_epoch) catch null) // null) as $synced |
            if $synced == null then null | field("Synced") else
                ([$now - $synced, 0] | max) as $age |
                ("Synced: " | styled("90")) +
                ($age | elapsed | styled(if $age > 10 then "1;31" else "90" end))
            end;
        def display_state:
            if .state == "Working" and (.tmux_pane_id // "") == "" then
                "Working (bg)"
            elif .state == "ActionRequired" then
                "Action Required"
            else .state // "Unknown" end | text;
        def colored_state($default):
            display_state as $state |
            ({Working: 36, "Working (bg)": 35, Idle: 32, "Action Required": "1;91", Approval: 33, Input: 33,
              Archived: 33, Error: 31}[$state] // $default) as $color |
            "\u001b[\($color)m\($state)\u001b[0m";
        def colored_state: colored_state(2);
JQ
}

list_options() {
    local mode="${1:?need mode}" host_filter="${2:-}"
    local sessions aliases show_archived=false show_ignored=false ignore_file=/dev/null
    sessions="$(multienv-agent "$mode" list-all 2>>"$log_file")" || return
    aliases="$(jq -r 'keys[]' <<<"$sessions" | host_aliases)" || return
    archived_visible && show_archived=true
    ignored_visible && show_ignored=true
    if [[ "$mode" == codex && "$show_ignored" == false && -f "$c_tui_ignore_file_path" ]]; then
        ignore_file="$c_tui_ignore_file_path"
    fi

    jq -r --arg mode "$mode" --arg host_filter "$host_filter" \
        --argjson aliases "$aliases" --argjson show_archived "$show_archived" \
        --rawfile ignore_rules "$ignore_file" \
        "$(ui_jq_helpers)"'
        now as $now |
        ($ignore_rules | split("\n") |
            map(sub("\r$"; "") | select(test("^\\s*(#|$)") | not))) as $patterns |
        # Validate every rule before emitting rows, even if there are no sessions.
        ($patterns | map(. as $pattern | try ("" | test($pattern))
            catch error("Invalid TUI ignore regex \($pattern): \(.)"))) as $_ |
        to_entries[] | .key as $host |
        select($host_filter == "" or $host == $host_filter) |
        .value | to_entries[] |
        .value + {hostname: $host, id: .key} |
        select($mode == "tmux" or $show_archived or .state != "Archived") |
        . as $session |
        (if $mode == "tmux" then .name else .title end) as $title |
        (if ($title // "") == "" then .id else $title end | text) as $label |
        (if $mode == "tmux" then
            [$label, $aliases[$host],
             ("\(.window_count) windows · " + (.synced_at | synced_field($now)))]
         else
            [colored_state, $aliases[$host], $label]
         end) + [$host, .id, ($session | tojson | @base64)] | @tsv |
        . as $row |
        (gsub("\u001b\\[[0-9;]*m"; "")) as $plain_row |
        select(any($patterns[]; . as $pattern | $plain_row | test($pattern)) | not) |
        $row
    ' <<<"$sessions"
}

decode_session() {
    jq -Rer '@base64d | fromjson' <<<"${1:?need session}"
}

preview_session() {
    local session host
    session="$(decode_session "${1:-}")" || return
    host="$(jq -r '.hostname' <<<"$session")"
    jq -r --arg host_alias "$(ui_host_alias "$host")" "$(ui_jq_helpers)"'
        def message:
            if test("^[[:space:]]*$") then "—" | styled("90")
            else gsub("[\u0000-\u0009\u000b-\u001f\u007f-\u009f]"; " ") end;
        (("Host: " | styled("90")) + $host_alias),
        (.work_dir | field("Directory")),
        (.id | field("Session")),
        (.tmux_pane_id | field("Pane")),
        (.synced_at | synced_field(now)), "",
        ((.title // "" | text) as $title |
            (if ($title | test("^[[:space:]]*$")) then .id | text else $title end) |
            styled("1;36")), "",
        "\u001b[1mState: \(colored_state("1;37"))\u001b[0m", "",
        ("First Message" | styled("1;35")), "",
        (.first_message // "" | message), "",
        ("Last Message" | styled("1;35")), "",
        (.last_message // "" | message)
    ' <<<"$session"
}

ui_header() {
    local mode="${1:?need mode}" archives=hidden ignored=hidden
    if [[ "$mode" == tmux ]]; then
        printf 'TMUX · ctrl-b Codex\nEnter switch · Tab select\n'
        printf 'ctrl-n new · ctrl-r rename · ctrl-x kill\n'
    else
        archived_visible && archives=shown
        ignored_visible && ignored=shown
        printf 'CODEX · archives %s · ignored %s · ctrl-b tmux\n' "$archives" "$ignored"
        printf 'Enter switch/resume · Tab select\n'
        printf 'ctrl-a archive · ctrl-u unarchive\nctrl-x delete · ctrl-g archived\n'
        printf 'ctrl-t ignored\n'
    fi
}

ui_prompt() {
    local mode="${1:?need mode}" archived=- ignored=-
    if [[ "$mode" == codex ]]; then
        archived_visible && archived=+
        ignored_visible && ignored=+
        printf '(%sa %si) ❯ ' "$archived" "$ignored"
    else
        printf '❯ '
    fi
}

session_action() {
    local mode="${1:?need mode}" action="${2:?need action}"
    shift 2
    local encoded session status=0
    for encoded in "$@"; do
        [[ -n "$encoded" ]] || continue
        session="$(decode_session "$encoded")" || return
        if ! jq '{hostname, session_id: .id}' <<<"$session" |
            multienv-agent "$mode" "$action" >>"$log_file" 2>&1; then
            show_error "Failed: $action"
            status=1
        fi
    done
    return "$status"
}

rename_session() {
    local session name
    session="$(decode_session "${1:?need session}")" || return
    IFS= read -r -p 'New session name: ' name </dev/tty || return
    [[ -n "$name" ]] || return 0
    jq --arg name "$name" '{hostname, session_id: .id, new_name: $name}' <<<"$session" |
        multienv-agent tmux rename-session >>"$log_file" 2>&1 || show_error 'Rename failed'
}

query_string() {
    local prompt="${1:?need prompt}" response_file popup_command response
    if ! popup_enabled; then
        IFS= read -r -p "$prompt: " response </dev/tty || return
        printf '%s\n' "$response"
        return
    fi
    response_file="$(mktemp "${MULTIENV_TUI_STATE_DIR}/response.XXXXXX")" || return
    printf -v popup_command 'printf %%s %q; IFS= read -r response; ' "$prompt: "
    printf -v popup_command '%sprintf "%%s\\n" "$response" > %q' \
        "$popup_command" "$response_file"
    tmux display-popup -E "$popup_command" || return
    cat "$response_file"
    rm -f "$response_file"
}

create_session() {
    local hosts aliases selected host name
    hosts="$(multienv-agent tmux list-all 2>>"$log_file" | jq -r 'keys[]')" || return
    hosts="$(printf '%s\n' "$hosts" "${c_hostnames[@]}" | sed '/^$/d' | sort -u)"
    aliases="$(host_aliases <<<"$hosts")" || return
    selected="$(jq -r 'to_entries[] | [.value, .key] | @tsv' <<<"$aliases" |
        ui_fzf --ansi --select-1 --no-multi --no-expect \
            --delimiter=$'\t' --with-nth=1 --accept-nth=2 --prompt='Choose host ❯ ' \
            --preview-window=hidden)" || return 0
    [[ -n "$selected" ]] || return 0
    host="$selected"
    name="$(query_string 'Session name')" || return
    [[ -n "$name" ]] || return 0
    jq -n --arg host "$host" --arg name "$name" '{hostname: $host, name: $name}' |
        multienv-agent tmux new-session >>"$log_file" 2>&1 || show_error 'Create failed'
}

select_pane() {
    local host="${1:?need hostname}" pane="${2:?need pane id}"
    select_session "$host" "$pane"
}

create_codex_pane() {
    local session="${1:?need session}" host id work_dir
    local options selected session_id result
    host="$(jq -r '.hostname' <<<"$session")"
    id="$(jq -r '.id' <<<"$session")"
    work_dir="$(jq -r '.work_dir' <<<"$session")"
    options="$(list_options tmux "$host")" || return
    if [[ -z "$options" ]]; then
        show_error 'Create a tmux session on this host first'
        return 1
    fi
    selected="$(ui_fzf --ansi --select-1 --no-multi --no-expect \
        --delimiter=$'\t' --with-nth=1,2,3 --accept-nth=6 \
        --prompt='Resume in tmux session ❯ ' --preview-window=hidden <<<"$options")" || return
    [[ -n "$selected" ]] || return 1
    session_id="$(decode_session "$selected" | jq -r '.id')" || return
    result="$(jq -n --arg host "$host" --arg session "$session_id" \
        --arg name "codex-${id:0:8}" --arg dir "$work_dir" --arg id "$id" \
        '{hostname: $host, session_id: $session, name: $name, work_dir: $dir,
          command: ["multienv-tui", "--resume-when-visible", $id]}' |
        multienv-agent tmux new-window 2>>"$log_file")" || {
        show_error 'Failed to create a tmux window'
        return 1
    }
    jq -er '.tmux_pane_id | select(type == "string" and test("^%[0-9]+$"))' \
        <<<"$result" || {
        show_error 'New window response has no pane ID'
        return 1
    }
}

exec_codex() {
    local id="${1:?need session id}" work_dir="${2:-}"
    local args=(--no-daemon)
    command -v codex >/dev/null || {
        show_error 'Missing command: codex'
        return 1
    }
    if [[ -n "$work_dir" ]]; then
        [[ -d "$work_dir" ]] || {
            show_error 'Session directory not found'
            return 1
        }
        args+=(--cd "$work_dir")
    fi
    args+=(resume "$id")
    # Stop the dashboard before replacing it; Codex owns this pane and its terminal.
    cleanup
    trap - EXIT INT TERM
    # Preserve the pane's TTY descriptors; /dev/tty cannot be polled by kqueue on macOS.
    exec codex "${args[@]}"
}

wait_for_visible_pane() {
    local pane="${1:?need pane id}" timeout="${2:-60}" deadline state
    deadline=$((SECONDS + timeout))
    while ((SECONDS < deadline)); do
        state="$(tmux display-message -p -t "$pane" \
            '#{pane_active}:#{window_active}:#{session_attached}' 2>>"$log_file")" || {
            show_error 'Cannot check Codex pane visibility'
            return 1
        }
        [[ "$state" =~ ^1:1:[1-9][0-9]*$ ]] && return 0
        sleep 0.1
    done
    show_error "No client switched to the Codex pane within $timeout seconds"
    return 1
}

resume_when_visible() {
    local id="${1:?need session id}"
    is_in_tmux || die 'Run the Codex launcher inside tmux'
    trap 'exit 130' INT
    trap 'exit 143' TERM
    wait_for_visible_pane "${TMUX_PANE:?need pane id}" || return
    exec_codex "$id"
}

open_codex_session() {
    local encoded="${1:?need session}" session host id pane
    session="$(decode_session "$encoded")" || return
    host="$(jq -r '.hostname' <<<"$session")"
    id="$(jq -r '.id' <<<"$session")"
    # Refresh before resuming so a stale picker row does not launch another process.
    session="$(multienv-agent codex list-all 2>>"$log_file" |
        jq -e --arg host "$host" --arg id "$id" '.[$host][$id]')" || {
        show_error 'Codex session no longer available'
        return 1
    }
    pane="$(jq -r '.tmux_pane_id // empty' <<<"$session")"
    if [[ -z "$pane" ]]; then
        session="$(jq -n --arg host "$host" --arg id "$id" \
            '{hostname: $host, session_id: $id}' |
            multienv-agent codex prepare-resume 2>>"$log_file")" || {
            show_error 'Prepare resume failed'
            return 1
        }
        if ! popup_enabled && is_on_hostname "$host"; then
            exec_codex "$id" "$(jq -r '.work_dir' <<<"$session")"
            return
        fi
        pane="$(create_codex_pane "$session")" || return
    fi
    select_pane "$host" "$pane"
}

picker_bindings() {
    local mode="${1:?need mode}" bindings
    bindings='start:hide-header,?:toggle-header'
    bindings+=',enter:clear-multi+accept,double-click:clear-multi+accept'
    if [[ "$mode" == tmux ]]; then
        bindings+=",ctrl-x:execute-silent($self_command --action tmux kill-session {+6})"
        bindings+="+reload-sync($self_command --list tmux)+clear-multi"
        bindings+=",ctrl-r:execute($self_command --rename {6})"
        bindings+="+reload-sync($self_command --list tmux)+clear-multi"
    else
        local key action
        for key in ctrl-a ctrl-u ctrl-x; do
            case "$key" in
            ctrl-a) action=archive-session ;;
            ctrl-u) action=unarchive-session ;;
            ctrl-x) action=delete-session ;;
            esac
            bindings+=",$key:execute-silent($self_command --action codex $action {+6})"
            bindings+="+reload-sync($self_command --list codex)+clear-multi"
        done
        bindings+=",ctrl-g:execute-silent($self_command --toggle-archived)"
        bindings+="+transform-header($self_command --header codex)"
        bindings+="+transform-prompt($self_command --prompt codex)"
        bindings+="+reload-sync($self_command --list codex)+clear-multi"
        bindings+=",ctrl-t:execute-silent($self_command --toggle-ignored)"
        bindings+="+transform-header($self_command --header codex)"
        bindings+="+transform-prompt($self_command --prompt codex)"
        bindings+="+reload-sync($self_command --list codex)+clear-multi"
    fi
    printf '%s\n' "$bindings"
}

run_picker() {
    local mode="${1:?need mode}" query="${2:-}" options keys=ctrl-b
    local refresh_binding="every(2):reload-sync($self_command --list $mode)"
    local args=()
    options="$(list_options "$mode")" || return
    if [[ "$mode" == tmux ]]; then
        keys+=,ctrl-n
        args+=(--preview-window=hidden)
    else
        refresh_binding+='+refresh-preview'
        popup_enabled && args+=(--tmux=center,90%,90%)
        args+=(--layout=reverse --tabstop=16)
        args+=(--preview="$self_command --preview {6}")
        args+=(--preview-window='right,50%,border-left,wrap')
    fi
    ui_fzf --ansi --multi --no-select-1 --no-expect --expect="$keys" \
        --prompt="$(ui_prompt "$mode")" --delimiter=$'\t' --with-nth=1,2,3 --nth=1,2,3 \
        --track --id-nth=4,5 --print-query --query="$query" \
        --header="$(ui_header "$mode")" --with-shell="$child_shell" \
        --bind="$(picker_bindings "$mode")" \
        --bind="$refresh_binding" \
        "${args[@]}" <<<"$options"
}

sync_agents() {
    local tmux_pid='' codex_pid='' sleep_pid=''
    trap 'kill "$tmux_pid" "$codex_pid" "$sleep_pid" 2>/dev/null; exit 0' INT TERM
    while true; do
        multienv-agent tmux sync-all >>"$log_file" 2>&1 &
        tmux_pid=$!
        multienv-agent codex sync-all >>"$log_file" 2>&1 &
        codex_pid=$!
        wait "$tmux_pid" "$codex_pid"
        tmux_pid='' codex_pid=''
        sleep 2 &
        sleep_pid=$!
        wait "$sleep_pid"
        sleep_pid=''
    done
}

cleanup() {
    if [[ -n "$sync_pid" ]]; then
        kill "$sync_pid" 2>/dev/null || true
        wait "$sync_pid" 2>/dev/null || true
    fi
    [[ -z "${MULTIENV_TUI_STATE_DIR:-}" ]] || rm -rf "$MULTIENV_TUI_STATE_DIR"
}

main() {
    local mode="${1:-tmux}" selected query key rows encoded status command
    local -A queries=([tmux]='' [codex]='')
    is_in_tmux || die 'Run multienv-tui inside tmux'
    for command in fzf jq multienv-agent; do
        command -v "$command" >/dev/null || die "Missing command: $command"
    done
    MULTIENV_TUI_STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/multienv-tui.XXXXXX")" || return
    export MULTIENV_TUI_STATE_DIR
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    sync_agents &
    sync_pid=$!

    while true; do
        selected="$(run_picker "$mode" "${queries[$mode]}")"
        status=$?
        ((status == 130)) && return 0
        if ((status != 0)) && [[ -z "$selected" ]]; then
            return "$status"
        fi
        query="${selected%%$'\n'*}"
        rows="${selected#*$'\n'}"
        key="${rows%%$'\n'*}"
        rows="${rows#*$'\n'}"
        queries[$mode]="$query"
        case "$key" in
        ctrl-b)
            if [[ "$mode" == tmux ]]; then mode=codex; else mode=tmux; fi
            ;;
        ctrl-n) create_session ;;
        '')
            [[ "$rows" == *$'\t'* ]] || continue
            encoded="$(cut -f6 <<<"${rows%%$'\n'*}")"
            if [[ "$mode" == codex ]]; then
                open_codex_session "$encoded" && return 0
            else
                selected="$(decode_session "$encoded")" || return
                select_session "$(jq -r '.hostname' <<<"$selected")" \
                    "$(jq -r '.id' <<<"$selected")" && return 0
            fi
            ;;
        *) return 0 ;;
        esac
    done
}

usage() {
    printf 'Usage: multienv-tui [--no-popup] [tmux|codex]\n\n'
    printf '  --no-popup  Show the dashboard in the current tmux pane\n'
    printf '              Local resume replaces the dashboard in this pane\n\n'
    ui_header tmux
    printf '\n'
    ui_header codex
}

start_ui() {
    local mode=tmux
    while (($# > 0)); do
        case "$1" in
        --no-popup) export MULTIENV_TUI_POPUP=0 ;;
        tmux | codex) mode="$1" ;;
        --help | -h)
            usage
            return
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            return 2
            ;;
        esac
        shift
    done
    main "$mode"
}

dispatch() {
    case "${1:-tmux}" in
    --list) list_options "${2:?need mode}" "${3:-}" ;;
    --preview) [[ -z "${2:-}" ]] || preview_session "$2" ;;
    --header) ui_header "${2:?need mode}" ;;
    --prompt) ui_prompt "${2:?need mode}" ;;
    --toggle-archived) toggle_archived ;;
    --toggle-ignored) toggle_ignored ;;
    --action)
        shift
        session_action "$@"
        ;;
    --rename) [[ -z "${2:-}" ]] || rename_session "$2" ;;
    --resume-when-visible) resume_when_visible "${2:?need session id}" ;;
    tmux | codex | --no-popup | --help | -h | '') start_ui "$@" ;;
    *)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
}

dispatch "$@"
